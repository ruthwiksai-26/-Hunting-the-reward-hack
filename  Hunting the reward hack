        "import numpy as np\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Set random seed for reproducibility\n",
        "np.random.seed(42)\n",
        "torch.manual_seed(42)\n",
        "\n",
        "print(\"⚡ Initializing Assignment Option 3: Hunting the Reward Hack Experiment...\")\n",
        "\n",
        "# =====================================================================\n",
        "# 1. ENVIRONMENT & TRUE REWARD DEFINITION\n",
        "# =====================================================================\n",
        "# We model text/policy outputs as continuous feature vectors of size 10.\n",
        "# Features 0-7: Actual semantic quality metrics.\n",
        "# Feature 8: Sequence length / Verbosity.\n",
        "# Feature 9: Superficial formatting (e.g., repeating pleasant greetings).\n",
        "FEATURE_DIM = 10\n",
        "\n",
        "def get_true_reward(features):\n",
        "    \"\"\"\n",
        "    The True Ground Truth Reward Function.\n",
        "    Appreciates true quality, but penalizes extreme verbosity/formatting hacks.\n",
        "    \"\"\"\n",
        "    # Base true quality from semantic features\n",
        "    quality = torch.sum(features[:, :8], dim=1)\n",
        "    # The true penalty for superficial optimization (Over-verbosity/repetitive formats)\n",
        "    verbosity_penalty = 0.4 * torch.square(features[:, 8]) + 0.3 * torch.square(features[:, 9])\n",
        "    return quality - verbosity_penalty\n",
        "\n",
        "def generate_preference_dataset(num_samples, noise_level=0.1):\n",
        "    \"\"\"Generates pairwise comparison data based on True Reward with noise.\"\"\"\n",
        "    # Sample random policy generated vectors\n",
        "    x_chosen = torch.randn(num_samples, FEATURE_DIM) * 1.5\n",
        "    x_rejected = torch.randn(num_samples, FEATURE_DIM) * 1.5\n",
        "\n",
        "    r_c = get_true_reward(x_chosen)\n",
        "    r_r = get_true_reward(x_rejected)\n",
        "\n",
        "    # Add human labeling noise\n",
        "    r_c_noisy = r_c + torch.randn(num_samples) * noise_level\n",
        "    r_r_noisy = r_r + torch.randn(num_samples) * noise_level\n",
        "\n",
        "    # Ensure x_chosen actually has the higher noisy reward\n",
        "    swap_mask = r_c_noisy < r_r_noisy\n",
        "    temp = x_chosen[swap_mask]\n",
        "    x_chosen[swap_mask] = x_rejected[swap_mask]\n",
        "    x_rejected[swap_mask] = temp\n",
        "\n",
        "    return x_chosen, x_rejected\n",
        "\n",
        "# =====================================================================\n",
        "# 2. PROXY REWARD MODEL ARCHITECTURES\n",
        "# =====================================================================\n",
        "class SmallRewardModel(nn.Module):\n",
        "    \"\"\"Linear Reward Model - Low capacity, high bias.\"\"\"\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.net = nn.Linear(FEATURE_DIM, 1)\n",
        "    def forward(self, x):\n",
        "        return self.net(x).squeeze(-1)\n",
        "\n",
        "class LargeRewardModel(nn.Module):\n",
        "    \"\"\"Deep Neural Network Reward Model - High capacity, low bias, overfits fast.\"\"\"\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.net = nn.Sequential(\n",
        "            nn.Linear(FEATURE_DIM, 64),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(64, 32),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(32, 1)\n",
        "        )\n",
        "    def forward(self, x):\n",
        "        return self.net(x).squeeze(-1)\n",
        "\n",
        "def train_reward_model(model, chosen_data, rejected_data, epochs=150):\n",
        "    \"\"\"Trains a proxy Reward Model using Bradley-Terry preference loss.\"\"\"\n",
        "    optimizer = optim.Adam(model.parameters(), lr=0.01)\n",
        "    model.train()\n",
        "    for epoch in range(epochs):\n",
        "        optimizer.zero_grad()\n",
        "        r_chosen = model(chosen_data)\n",
        "        r_rejected = model(rejected_data)\n",
        "        # Binary Cross Entropy / Bradley-Terry loss\n",
        "        loss = -torch.mean(torch.log(torch.sigmoid(r_chosen - r_rejected) + 1e-6))\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "    model.eval()\n",
        "    return model\n",
        "\n",
        "# =====================================================================\n",
        "# 3. EXPERIMENT PIPELINE (Ablating Size and Data Amount)\n",
        "# =====================================================================\n",
        "# Generate baseline datasets\n",
        "x_chosen_small, x_rejected_small = generate_preference_dataset(num_samples=40, noise_level=0.3)\n",
        "x_chosen_large, x_rejected_large = generate_preference_dataset(num_samples=800, noise_level=0.1)\n",
        "\n",
        "# Initialize and train our 3 experimental configurations\n",
        "configurations = {\n",
        "    \"Small RM / Scant Data\": (SmallRewardModel(), x_chosen_small, x_rejected_small),\n",
        "    \"Small RM / Abundant Data\": (SmallRewardModel(), x_chosen_large, x_rejected_large),\n",
        "    \"Large RM / Abundant Data\": (LargeRewardModel(), x_chosen_large, x_rejected_large)\n",
        "}\n",
        "\n",
        "trained_models = {}\n",
        "for name, (model, c_data, r_data) in configurations.items():\n",
        "    print(f\"-> Training configuration: {name}...\")\n",
        "    trained_models[name] = train_reward_model(model, c_data, r_data)\n",
        "\n",
        "# =====================================================================\n",
        "# 4. POLICY OPTIMIZATION & TRACKING OVER-OPTIMIZATION PEAK\n",
        "# =====================================================================\n",
        "steps = 60\n",
        "results = {name: {\"proxy_r\": [], \"true_r\": [], \"hack_feature\": []} for name in configurations.keys()}\n",
        "\n",
        "for name, proxy_rm in trained_models.items():\n",
        "    # Initialize a policy representation (starting at neutral state)\n",
        "    policy_params = torch.zeros(1, FEATURE_DIM, requires_grad=True)\n",
        "    policy_optimizer = optim.SGD([policy_params], lr=0.1) # Simulate gradient ascent/hill climbing\n",
        "\n",
        "    for step in range(steps):\n",
        "        # We evaluate current policy parameter directly\n",
        "        current_proxy_r = proxy_rm(policy_params)\n",
        "\n",
        "        # Policy maximizes the Proxy Reward\n",
        "        loss = -torch.mean(current_proxy_r)\n",
        "\n",
        "        policy_optimizer.zero_grad()\n",
        "        loss.backward()\n",
        "        policy_optimizer.step()\n",
        "\n",
        "        # Log metrics to measure optimization trajectory\n",
        "        with torch.no_grad():\n",
        "            true_r = get_true_reward(policy_params).item()\n",
        "            proxy_r = current_proxy_r.item()\n",
        "            # Feature 8 tracks the 'verbosity/hack' trait\n",
        "            hack_val = torch.abs(policy_params[0, 8]).item()\n",
        "\n",
        "            results[name][\"proxy_r\"].append(proxy_r)\n",
        "            results[name][\"true_r\"].append(true_r)\n",
        "            results[name][\"hack_feature\"].append(hack_val)\n",
        "\n",
        "# =====================================================================\n",
        "# 5. VISUALIZATION AND DIAGNOSIS PLOTS\n",
        "# =====================================================================\n",
        "fig, axes = plt.subplots(1, 2, figsize=(15, 6))\n",
        "\n",
        "colors = {\"Small RM / Scant Data\": \"#e74c3c\", \"Small RM / Abundant Data\": \"#3498db\", \"Large RM / Abundant Data\": \"#2ecc71\"}\n",
        "\n",
        "# Plot 1: Optimization Curves (True Reward vs Proxy Reward)\n",
        "for name in results.keys():\n",
        "    axes[0].plot(results[name][\"proxy_r\"], linestyle='--', alpha=0.6, color=colors[name], label=f\"{name} (Proxy)\")\n",
        "    axes[0].plot(results[name][\"true_r\"], linestyle='-', linewidth=2.5, color=colors[name], label=f\"{name} (True)\")\n",
        "axes[0].set_title(\"Reward Over-Optimization (Goodhart's Law Peak)\", fontsize=13)\n",
        "axes[0].set_xlabel(\"Optimization Pressure (Policy Steps)\")\n",
        "axes[0].set_ylabel(\"Reward Value\")\n",
        "axes[0].grid(True, alpha=0.3)\n",
        "axes[0].legend(fontsize=9)\n",
        "\n",
        "# Plot 2: Diagnosis - What the Policy Exploits\n",
        "for name in results.keys():\n",
        "    axes[1].plot(results[name][\"hack_feature\"], linewidth=2, color=colors[name], label=name)\n",
        "axes[1].set_title(\"Policy Exploitation Diagnosis (Verbosity Hack Over-Time)\", fontsize=13)\n",
        "axes[1].set_xlabel(\"Optimization Pressure (Policy Steps)\")\n",
        "axes[1].set_ylabel(\"Magnitude of Exploited Feature (Feature 8)\")\n",
        "axes[1].grid(True, alpha=0.3)\n",
        "axes[1].legend(fontsize=9)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Print Analytical Summary Diagnosis\n",
        "print(\"\\n\" + \"=\"*70 + \"\\nDIAGNOSIS REPORT:\\n\" + \"=\"*70)\n",
        "for name in results.keys():\n",
        "    true_arr = results[name][\"true_r\"]\n",
        "    peak_idx = np.argmax(true_arr)\n",
        "    peak_val = true_arr[peak_idx]\n",
        "    final_val = true_arr[-1]\n",
        "    print(f\"📌 [{name}]\")\n",
        "    print(f\"   - Over-optimization Peak occurs at step: {peak_idx} (Max True Reward: {peak_val:.2f})\")\n",
        "    print(f\"   - Post-peak degradation drop: {peak_val - final_val:.2f}\")\n",
        "    print(f\"   - Policy Exploitation Value at final step: {results[name]['hack_feature'][-1]:.2f}\")\n"
      ]
    }
